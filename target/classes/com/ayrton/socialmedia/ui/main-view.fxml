<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox spacing="10" xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.ayrton.socialmedia.controller.MainController"
      style="-fx-background-color: #e8eaf6;">

    <!-- TITRE CENTRÉ -->
    <HBox alignment="CENTER">
        <Label text="SocialMedia-Publication"
               style="-fx-font-size: 30px; -fx-text-fill: darkslateblue; -fx-font-weight: bold;"/>
    </HBox>

    <HBox spacing="15" VBox.vgrow="ALWAYS">

        <!-- TABLE -->
        <VBox spacing="10" VBox.vgrow="ALWAYS" style="-fx-padding: 10;">
            <TableView fx:id="tableView"
                       prefWidth="800"
                       prefHeight="500"
                       style="-fx-font-size: 16px; -fx-border-color: lightgray;">
                <columns>
                    <TableColumn fx:id="idCol" text="UID" prefWidth="120"/>
                    <TableColumn fx:id="authorCol" text="Auteur" prefWidth="180"/>
                    <TableColumn fx:id="contentCol" text="Contenu" prefWidth="300"/>
                    <TableColumn fx:id="typeCol" text="Type" prefWidth="140"/>
                    <TableColumn fx:id="dateCol" text="Created At" prefWidth="160"/>
                    <TableColumn fx:id="validCol" text="Validité" prefWidth="120"/>
                </columns>
            </TableView>
        </VBox>

        <!-- BOUTONS -->
        <VBox spacing="15" alignment="TOP_CENTER" style="-fx-padding: 10;">
            <Button text="➕ Ajouter" onAction="#handleAdd"
                    style="-fx-background-color: DARKSLATEBLUE; -fx-text-fill: white; -fx-min-width: 140;"/>
            <Button text="✏️ Modifier" onAction="#handleEdit"
                    style="-fx-background-color: DARKSLATEBLUE; -fx-text-fill: white; -fx-min-width: 140;"/>
            <Button text="📄 Cloner" onAction="#handleClone"
                    style="-fx-background-color: DARKSLATEBLUE; -fx-text-fill: white; -fx-min-width: 140;"/>
            <Button text="🗑 Supprimer" onAction="#handleDelete"
                    style="-fx-background-color: DARKSLATEBLUE; -fx-text-fill: white; -fx-min-width: 140;"/>
            <Button text="🔄 Actualiser" onAction="#handleRefresh"
                    style="-fx-background-color: DARKSLATEBLUE; -fx-text-fill: white; -fx-min-width: 140;"/>
            <Button text="❌ Quitter" onAction="#handleQuit"
                    style="-fx-background-color: DARKSLATEBLUE; -fx-text-fill: white; -fx-min-width: 140;"/>
        </VBox>

        <!-- FORMULAIRE -->
        <VBox fx:id="form"
              spacing="12"
              visible="false"
              prefWidth="350"
              maxHeight="450"
              alignment="TOP_CENTER"
              style="-fx-background-color: #f4f4f4; -fx-padding: 20; -fx-border-color: #c0c0c0;">

            <!-- CROIX -->
            <HBox alignment="TOP_RIGHT">
                <Button text="❌" onAction="#handleCloseForm"/>
            </HBox>

            <!-- TITRE DU FORMULAIRE -->
            <Label fx:id="formHeader"
                   text="Nouvelle Publication"
                   style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: darkslateblue;"/>

            <Label text="Type"/>
            <ComboBox fx:id="typeBox"/>

            <Label fx:id="authorLabel" text="Auteur"/>
            <TextField fx:id="authorField" visible="false"/>

            <Label fx:id="contentLabel" text="Contenu"/>
            <TextField fx:id="contentField" visible="false"/>

            <Label fx:id="extraLabel"/>
            <CheckBox fx:id="extraCheck" visible="false"/>

            <Label fx:id="durationLabel" text="Durée (sec)" visible="false"/>
            <TextField fx:id="durationField" visible="false"/>

            <Button text="Enregistrer" onAction="#handleSave"
                    style="-fx-background-color: DARKSLATEBLUE; -fx-text-fill: white;"/>
        </VBox>

    </HBox>

</VBox>